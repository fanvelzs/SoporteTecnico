<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.soportetecnico.SolicitudController">
    <content>
        <VBox spacing="16.0">
            <padding><Insets bottom="30.0" left="42.0" right="42.0" top="30.0" /></padding>
            <Label text="Solicitud de servicio">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>
            <Label text="Seleccione un cliente registrado y detalle el problema." />
            <Separator />
            <GridPane hgap="16.0" vgap="13.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="180.0" prefWidth="200.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="320.0" />
                    <ColumnConstraints minWidth="105.0" />
                </columnConstraints>
                <Label text="Cliente *" GridPane.rowIndex="0" />
                <ComboBox fx:id="clienteCombo" maxWidth="Infinity" promptText="Seleccione un cliente" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0" />
                <Label text="Correo del cliente *" GridPane.rowIndex="1" />
                <TextField fx:id="correoField" editable="false" promptText="Se completa al seleccionar el cliente" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                <Label text="Tipo de cliente *" GridPane.rowIndex="2" />
                <TextField fx:id="tipoClienteField" editable="false" promptText="Se completa al seleccionar el cliente" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                <Label text="Asunto *" GridPane.rowIndex="3" />
                <TextField fx:id="asuntoField" promptText="Resumen del problema" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                <Label text="Tipo de servicio *" GridPane.rowIndex="4" />
                <ComboBox fx:id="tipoServicioCombo" maxWidth="Infinity" promptText="Seleccione una opción" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="4" />
                <Label text="Prioridad *" GridPane.rowIndex="5" />
                <HBox spacing="22.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="5">
                    <RadioButton fx:id="bajaRadio" text="Baja" />
                    <RadioButton fx:id="mediaRadio" text="Media" />
                    <RadioButton fx:id="altaRadio" text="Alta" />
                </HBox>
                <Label text="Descripción del problema *" wrapText="true" GridPane.rowIndex="6" />
                <TextArea fx:id="descripcionArea" prefRowCount="5" promptText="Explique el problema con suficiente detalle" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="6" />
                <Label text="Archivo adjunto *" GridPane.rowIndex="7" />
                <TextField fx:id="archivoField" editable="false" promptText="Ningún archivo seleccionado" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                <Button onAction="#seleccionarArchivo" text="Examinar..." GridPane.columnIndex="2" GridPane.rowIndex="7" />
                <Label text="Carpeta de evidencias *" GridPane.rowIndex="8" />
                <TextField fx:id="evidenciasField" editable="false" promptText="Ninguna carpeta seleccionada" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                <Button onAction="#seleccionarEvidencias" text="Seleccionar..." GridPane.columnIndex="2" GridPane.rowIndex="8" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
            <Label text="* Campos obligatorios" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button onAction="#guardar" prefWidth="105.0" text="Guardar" />
                <Button onAction="#crearSolicitud" prefWidth="135.0" text="Crear solicitud" />
                <Button onAction="#limpiar" prefWidth="105.0" text="Limpiar" />
                <Button onAction="#cerrar" prefWidth="105.0" text="Cerrar" />
            </HBox>
        </VBox>
    </content>
</ScrollPane>
